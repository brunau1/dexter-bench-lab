{
  "name": "dexter-bench-cli",
  "version": "0.1.0",
  "description": "CLI of dexter-bench-lab: controlled, reproducible benchmark runs in Docker",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "bench": "dist/main.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
